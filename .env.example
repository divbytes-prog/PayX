# Core backend. Never commit real values.
DATABASE_URL=postgresql://user:password@host/database?sslmode=require
APP_URL=http://localhost:5173
SESSION_SECRET=replace-with-at-least-32-random-characters
# 32 random bytes encoded as base64. Used to encrypt merchant credentials.
CREDENTIAL_ENCRYPTION_KEY=

# Stripe Connect (OAuth) platform credentials.
STRIPE_SECRET_KEY=
STRIPE_CONNECT_CLIENT_ID=
STRIPE_WEBHOOK_SECRET=

# Optional platform-managed fallback credentials. Merchant credentials are
# normally saved per organization through the authenticated gateway API.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
PAYTM_MID=
PAYTM_MERCHANT_KEY=
PAYTM_WEBSITE=WEBSTAGING

# Keep true until provider test credentials and webhooks have been verified.
PAYX_SANDBOX_ONLY=true
