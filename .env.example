# Core backend. Never commit real values.
DATABASE_URL=postgresql://user:password@host/database?sslmode=require
APP_URL=http://localhost:5173
SESSION_SECRET=replace-with-at-least-32-random-characters
# 32 random bytes encoded as base64. Used to encrypt merchant credentials.
CREDENTIAL_ENCRYPTION_KEY=

# Stripe Connect platform credentials. Keep test and live keys separate.
STRIPE_SECRET_KEY=
STRIPE_CONNECT_CLIENT_ID=
STRIPE_WEBHOOK_SECRET=
STRIPE_LIVE_SECRET_KEY=
STRIPE_LIVE_CONNECT_CLIENT_ID=
STRIPE_LIVE_WEBHOOK_SECRET=

# Merchant Razorpay and Paytm credentials are connected inside each workspace.
# Each Razorpay merchant supplies their own webhook secret in Gateways.

# Keep true until provider test credentials and webhooks have been verified.
PAYX_SANDBOX_ONLY=true
